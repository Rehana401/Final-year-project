flowchart TB
    %% Styling for Black & White Documentation
    classDef default fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;
    classDef process fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;
    classDef store fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;

    User[Bank User]
    Admin[System Admin]
    
    subgraph Processes
        P1((1.0<br/>Authentication))
        P2((2.0<br/>Transaction Analysis))
        P3((3.0<br/>History Management))
        P4((4.0<br/>Model Training))
    end
    
    D1[(D1: USERS)]
    D2[(D2: ANALYSIS_HISTORY)]
    D3[(D3: MODEL_METADATA)]
    D4[(D4: Trained Models)]

    %% Flows
    User -- "Login Request" --> P1
    P1 <--> D1
    
    User -- "Transaction Details" --> P2
    P2 -- "Risk Result" --> User
    P2 <--> D4
    P2 --> P3
    
    P3 <--> D2
    P3 -- "Report Data" --> User
    
    Admin -- "Upload CSV" --> P4
    P4 --> D4
    P4 --> D3

    class P1,P2,P3,P4 process;
    class D1,D2,D3,D4 store;
