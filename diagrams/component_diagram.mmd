flowchart TB
    %% Styling for Black & White Documentation
    classDef default fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;
    classDef box fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;
    classDef db fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;

    subgraph Client [Client - React Frontend]
        direction TB
        UI[UI Components<br/>Framer Motion / Lucide]
        Context[Context API<br/>Auth & Theme]
        Services[API Services<br/>Axios / api.js]
    end

    subgraph API [API Layer - Flask Backend]
        direction TB
        Routes[Blueprint Routes<br/>predict, auth, admin]
        JWT[JWT Manager<br/>Security Middleware]
    end

    subgraph Core [Business Logic - Python Core]
        direction TB
        PE[Prediction Engine]
        FE[Feature Extractor]
        HM[History Manager]
        Trainer[Model Trainer]
    end

    subgraph Data [Data Layer]
        direction TB
        DB[(SQLite Database<br/>app.db)]
        Models[ML Models<br/>.pkl Files]
    end

    %% Interactions
    UI --> Context
    Context --> Services
    Services <== "JSON / HTTPS (Port 5000)" ==> Routes
    Routes --> JWT
    JWT --> PE
    PE --> FE
    Routes --> HM
    HM --> DB
    PE --> Models
    Trainer --> Models
    Trainer --> DB

    %% Apply Styles
    class Client,UI,Context,Services,API,Routes,JWT,Core,PE,FE,HM,Trainer,Data,Models box;
    class DB db;
