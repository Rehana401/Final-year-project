@startuml
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle

skinparam component {
    BackgroundColor white
    BorderColor black
    ArrowColor black
}

skinparam package {
    BackgroundColor white
    BorderColor black
}

skinparam database {
    BackgroundColor white
    BorderColor black
}

title SecurBank - Component Diagram (React/Flask Architecture)

package "Frontend (React 19)" {
    [UI Components] as UI
    [Context API] as Context
    [API Services] as Services
    UI ..> Context
    Context ..> Services
}

package "Backend API (Flask)" {
    [Blueprint Routes] as Routes
    [JWT Middleware] as JWT
    Routes ..> JWT
}

package "Logic Layer (Python)" {
    [Prediction Engine] as PE
    [Feature Extractor] as FE
    [History Manager] as HM
    [Model Trainer] as Trainer
}

database "Data Layer" {
    [app.db (SQLite)] as DB
    [Trained Models (.pkl)] as Models
}

' Interactions
Services <==> Routes : "JSON/REST API"
JWT --> PE
JWT --> HM
PE --> FE
HM --> DB
PE --> Models
Trainer --> Models
Trainer --> DB

@enduml
